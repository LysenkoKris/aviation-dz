      "item": [
        {
          "name": "Самолёты от 300 мест",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const registrations = pm.response.json().map(item => item.registrationNumber);",
                  "pm.test('есть RA-96002, нет RA-73001', function () {",
                  "    pm.expect(registrations).to.include('RA-96002');",
                  "    pm.expect(registrations).to.not.include('RA-73001');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/aircraft/by-capacity?minCapacity=300",
              "host": ["{{baseUrl}}"],
              "path": ["api", "aircraft", "by-capacity"],
              "query": [
                {
                  "key": "minCapacity",
                  "value": "300"
                }
              ]
            }
          }
        },
        {
          "name": "Рейсы со статусом SCHEDULED",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const flights = pm.response.json();",
                  "const numbers = flights.map(item => item.flightNumber);",
                  "pm.test('есть SU100 и SU200', function () {",
                  "    pm.expect(numbers).to.include('SU100');",
                  "    pm.expect(numbers).to.include('SU200');",
                  "    flights.forEach(item => pm.expect(item.aircraft.registrationNumber).to.be.a('string'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
