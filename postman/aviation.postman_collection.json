    {
      "name": "Добавление",
      "item": [
        {
          "name": "Новый самолёт",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('suffix', Date.now().toString().slice(-6));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const aircraft = pm.response.json();",
                  "pm.test('номер записан заглавными', function () {",
                  "    pm.expect(aircraft.registrationNumber).to.eql('RA-' + pm.collectionVariables.get('suffix'));",
                  "    pm.expect(aircraft.seatsCapacity).to.eql(98);",
                  "});",
                  "pm.collectionVariables.set('aircraftId', aircraft.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registrationNumber\": \"ra-{{suffix}}\",\n  \"model\": \"Sukhoi Superjet 100\",\n  \"seatsCapacity\": 98\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/aircraft",
              "host": ["{{baseUrl}}"],
              "path": ["api", "aircraft"]
            }
          }
        },
